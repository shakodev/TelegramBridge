# Copy to .env in the directory from which you launch the bridge.
# Process environment variables take precedence. Never commit .env.
TELEGRAM_BOT_TOKEN=123456789:replace_with_BotFather_token
TELEGRAM_ALLOWED_USERS=123456789

# Existing absolute directories, addressed only by these aliases in Telegram.
# Forward slashes avoid JSON backslash escaping on Windows.
BRIDGE_PROJECTS='{"demo":"C:/Users/YourName/Projects/Demo"}'
BRIDGE_DATABASE=data/bridge.sqlite

# Use a native executable, not a .cmd/.ps1 npm shim. Spaces are supported.
CODEX_BIN='C:/Users/YourName/AppData/Local/Programs/OpenAI/Codex/bin/codex.exe'
# Conservative default. workspace-write must be explicitly selected by the operator.
CODEX_SANDBOX=read-only

# Optional: separate Codex configuration/history directory for the bridge.
# Authenticate/configure this home using Codex before running the bridge.
# CODEX_HOME=C:/Users/YourName/.codex-telegram
# OPENAI_API_KEY=...
RUST_LOG=telegram_codex_bridge=info
